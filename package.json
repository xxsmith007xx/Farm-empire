{
  "name": "farm-empire",
  "version": "1.0.0",
  "private": true,
  "description": "Farm Empire: Sunny Acres — an idle chicken-farm game for web, Android and iOS.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "python3 -m http.server 8080",
    "build": "node scripts/build-web.js",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
